# Copy to .env and fill in as needed.

AQE_DATASET=nfcorpus
AQE_DATA_DIR=data
AQE_RESULTS_DIR=results
AQE_SEED=42

AQE_BM25_DB_PATH=data/bm25_index.sqlite3
AQE_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
AQE_RERANKER_TOP_K=50
AQE_RERANKER_MAX_CANDIDATES=100

LLM_PROVIDER=ollama
EXPANSION_MODEL=qwen3.5:2b
OLLAMA_BASE_URL=http://localhost:11434
HF_API_TOKEN=
ANTHROPIC_API_KEY=

AQE_LLM_CONTEXT_TOKENS=4096
AQE_LLM_OUTPUT_TOKENS=64
AQE_MAX_LLM_CALLS=2
AQE_ACTION_BUDGET=3

# Google Drive folder ID for the TripClick IR Benchmark package
# (scripts/02_download_tripclick.py). Non-commercial research use only;
# never commit or redistribute the downloaded data.
TRIPCLICK_DRIVE_FOLDER_ID=
